{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "rubber-duck",
  "model": "openai/gpt-5.6-luna",
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git status*": "allow",
      "gh repo view*": "allow",
      "gh api repos/*": "ask",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh search*": "allow",
      "go build*": "allow",
      "go test*": "allow",
      "gofmt*": "allow",
      "ls*": "allow",
      "which*": "allow",
      "mkdir*": "allow",
      "pwd*": "allow",
      "*&&*": "ask",
      "*||*": "ask",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*>>*": "ask",
      "*<<*": "ask",
      "*$(*": "ask",
      "*`*": "ask",
      "*<(*": "ask",
      "*!*": "ask",
      "*eval*": "ask"
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  }
}

{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "app_exit": "ctrl+c,ctrl+d,ctrl+q",
    "editor_open": "ctrl+e",
    "theme_list": "ctrl+t",
    "sidebar_toggle": "ctrl+.",
    "status_view": "ctrl+s",
    "tool_details": "none",
    "session_export": "none",
    "session_new": "ctrl+n",
    "session_list": "ctrl+l",
    "session_timeline": "ctrl+g",
    "session_fork": "none",
    "session_rename": "none",
    "session_share": "none",
    "session_unshare": "none",
    "session_interrupt": "escape",
    "session_compact": "none",
    "session_child_first": "ctrl+shift+down",
    "session_child_cycle": "right",
    "session_child_cycle_reverse": "left",
    "session_parent": "up",
    "messages_page_up": "none",
    "messages_page_down": "none",
    "messages_line_up": "none",
    "messages_line_down": "none",
    "messages_half_page_up": "none",
    "messages_half_page_down": "none",
    "messages_first": "none",
    "messages_last": "none",
    "messages_next": "ctrl+]",
    "messages_previous": "ctrl+[",
    "messages_copy": "ctrl+y",
    "messages_undo": "ctrl+shift+u",
    "messages_redo": "ctrl+shift+r",
    "messages_last_user": "none",
    "messages_toggle_conceal": "ctrl+h",
    "model_list": "ctrl+m",
    "model_cycle_recent": "none",
    "model_cycle_recent_reverse": "none",
    "model_cycle_favorite": "ctrl+f",
    "model_cycle_favorite_reverse": "ctrl+shift+f",
    "variant_cycle": "ctrl+`",
    "variant_list": "ctrl+i",
    "command_list": "ctrl+p",
    "agent_list": "ctrl+a"
  }
}

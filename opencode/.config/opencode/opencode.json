{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "gh repo view*": "allow",
      "gh api repos/*": "ask",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh search*": "allow",
      "mkdir*": "allow",
      "*&&*": "ask",
      "*||*": "ask",
      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*>>*": "ask",
      "*<<*": "ask",
      "*$(*": "ask",
      "*`*": "ask",
      "*<(*": "ask",
      "*!*": "ask",
      "*eval*": "ask"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "webfetch": "allow"
      }
    },
    "build": {
      "permission": {
        "webfetch": "allow",
        "edit": "allow"
      }
    }
  }
}

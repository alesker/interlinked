      "*;*": "ask",
      "*&*": "ask",
      "*|*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*>>*": "ask",
      "*<<*": "ask",
      "*$(*": "ask",
      "*`*": "ask",
      "*<(*": "ask",
      "*!*": "ask"
    },
    "webfetch": "ask"
  }
}

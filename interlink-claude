#!/usr/bin/env bash

set -eu

usage() {
  cat <<'EOF'
Usage: ./interlink-claude [--check]

Translate the OpenCode agents and deploy them, the shared skills, and the
global instructions to ~/.claude without replacing configuration owned by
anything else.

  --check  Report drift and conflicts without changing files
EOF
}

check_only=false
case "${1-}" in
  "") ;;
  --check) check_only=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
source_agents="$script_dir/opencode/agents"
source_skills="$script_dir/opencode/skills"
claude_home=${CLAUDE_CONFIG_DIR:-"$HOME/.claude"}
agents_dir="$claude_home/agents"
skills_dir="$claude_home/skills"
claude_md="$claude_home/CLAUDE.md"
manifest="$claude_home/.interlink-claude-manifest"
owner_marker='<!-- Generated by interlink-claude; do not edit. -->'
block_start='<!-- interlink-claude:start -->'
block_end='<!-- interlink-claude:end -->'
changed=false

if [ ! -d "$source_agents" ] || [ ! -d "$source_skills" ]; then
  printf 'error: run this command from an intact interlinked checkout\n' >&2
  exit 1
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/interlink-claude.XXXXXX")
trap 'rm -rf -- "$tmp_dir"' EXIT HUP INT TERM
mkdir -p -- "$tmp_dir/agents"
desired_manifest="$tmp_dir/manifest"
: > "$desired_manifest"

yaml_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}

frontmatter_value() {
  local key=$1
  local file=$2
  awk -v key="$key" '
    NR == 1 && $0 == "---" { frontmatter = 1; next }
    frontmatter && $0 == "---" { exit }
    frontmatter && index($0, key ":") == 1 {
      value = substr($0, length(key) + 2)
      sub(/^[[:space:]]+/, "", value)
      print value
      exit
    }
  ' "$file"
}

permission_is_denied() {
  local permission=$1
  local file=$2
  awk -v permission="$permission" '
    NR == 1 && $0 == "---" { frontmatter = 1; next }
    frontmatter && $0 == "---" { exit }
    frontmatter && $0 == "permission:" { permissions = 1; next }
    permissions && $0 !~ /^  / { permissions = 0 }
    permissions && $0 ~ ("^  " permission ":[[:space:]]*deny[[:space:]]*$") { denied = 1 }
    END { exit denied ? 0 : 1 }
  ' "$file"
}

validate_agent_frontmatter() {
  local file=$1
  awk -v file="$file" '
    function fail(message) {
      printf "error: %s: %s\n", file, message > "/dev/stderr"
      invalid = 1
    }
    NR == 1 && $0 == "---" { frontmatter = 1; next }
    frontmatter && $0 == "---" { frontmatter = 0; next }
    !frontmatter { next }
    index($0, "description:") == 1 {
      descriptions++
      value = substr($0, length("description:") + 1)
      sub(/^[[:space:]]+/, "", value)
      if (value == "" || value ~ /^[\047\"|>[{&*!]/ || value ~ /:[[:space:]]/ || value ~ /[[:space:]]#/) {
        fail("description must be an unquoted, single-line YAML scalar")
      }
    }
    $0 ~ /^  (edit|bash|webfetch):/ {
      value = $0
      sub(/^  [^:]+:[[:space:]]*/, "", value)
      if (value !~ /^(allow|ask|deny)$/) {
        fail("edit, bash, and webfetch permissions must use scalar allow/ask/deny values")
      }
    }
    END {
      if (descriptions > 1) fail("description must not be repeated")
      exit invalid ? 1 : 0
    }
  ' "$file"
}

write_builtin_fallback_body() {
  local name=$1
  case "$name" in
    build)
      cat <<'EOF'

You are the implementation agent. Carry requested changes through codebase investigation, editing, and appropriate verification.

- Implement rather than stopping at a proposal unless the user explicitly asks for a plan.
- Make the smallest complete change that satisfies the request and preserve established patterns.
- Resolve non-blocking ambiguity with reasonable assumptions; ask only when a decision is genuinely blocked.
- Do not modify unrelated work or introduce dependencies without justification.
- Verify the changed behavior with the most relevant available checks.
- Report what changed, what was verified, and anything that remains uncertain.
EOF
      ;;
    plan)
      cat <<'EOF'

You are the planning agent. Investigate the request and produce an implementation-ready plan without modifying files.

- Inspect the relevant code, configuration, call sites, and existing tests before proposing changes.
- Distinguish observed facts from assumptions and call out unresolved decisions.
- Recommend the smallest coherent approach, including concrete files or components when known.
- Cover important edge cases, migration or compatibility concerns, and verification.
- Keep the plan proportionate to the task and avoid speculative adjacent work.
EOF
      ;;
  esac
}

write_agent() {
  local source=$1
  local destination=$2
  local name description
  local tools=""

  validate_agent_frontmatter "$source"
  name=$(basename -- "$source" .md)
  description=$(frontmatter_value description "$source")
  if [ -z "$description" ]; then
    case "$name" in
      build) description="Implements requested changes and verifies the result" ;;
      plan) description="Investigates a task and produces a concrete implementation plan" ;;
      *) description="Interlinked $name agent" ;;
    esac
  fi

  if permission_is_denied edit "$source"; then
    tools="Edit, Write, NotebookEdit"
  fi
  # OpenCode's built-in Plan agent denies edits outside this sparse override.
  if [ "$name" = plan ]; then
    tools="Edit, Write, NotebookEdit"
  fi
  if permission_is_denied bash "$source"; then
    tools="${tools:+$tools, }Bash"
  fi
  if permission_is_denied webfetch "$source"; then
    tools="${tools:+$tools, }WebFetch"
  fi

  {
    printf '%s\n' '---'
    printf 'name: %s\n' "$name"
    printf 'description: %s\n' "$(yaml_quote "$description")"
    if [ -n "$tools" ]; then
      printf 'disallowedTools: [%s]\n' "$tools"
    fi
    printf '%s\n\n%s\n' '---' "$owner_marker"
    awk '
      NR == 1 && $0 == "---" { frontmatter = 1; next }
      frontmatter && $0 == "---" { frontmatter = 0; body = 1; next }
      body { print }
    ' "$source"
    if ! awk '
      NR == 1 && $0 == "---" { frontmatter = 1; next }
      frontmatter && $0 == "---" { frontmatter = 0; body = 1; next }
      body && $0 !~ /^[[:space:]]*$/ { content = 1 }
      END { exit content ? 0 : 1 }
    ' "$source"; then
      write_builtin_fallback_body "$name"
    fi
  } > "$destination"

  printf 'agent\t%s\n' "$name" >> "$desired_manifest"
}

for source in "$source_agents"/*.md; do
  [ -e "$source" ] || continue
  write_agent "$source" "$tmp_dir/agents/$(basename -- "$source")"
done

for source in "$source_skills"/*; do
  [ -d "$source" ] || continue
  [ -f "$source/SKILL.md" ] || continue
  printf 'skill\t%s\t%s\n' "$(basename -- "$source")" "$source" >> "$desired_manifest"
done
printf 'claude-md-block\tCLAUDE.md\n' >> "$desired_manifest"

manifest_skill_target() {
  local name=$1
  [ -f "$manifest" ] && awk -F '\t' -v name="$name" '
    $1 == "skill" && $2 == name { print $3; found = 1; exit }
    END { if (!found) exit 1 }
  ' "$manifest"
}

is_owned_agent() {
  local file=$1
  [ -f "$file" ] && awk -v marker="$owner_marker" '$0 == marker { found = 1 } END { exit found ? 0 : 1 }' "$file"
}

conflicts=false
for desired in "$tmp_dir/agents"/*.md; do
  [ -e "$desired" ] || continue
  name=$(basename -- "$desired" .md)
  target="$agents_dir/$name.md"
  if [ -L "$target" ]; then
    printf 'conflict: refusing to replace symlinked agent %s\n' "$target" >&2
    conflicts=true
  elif [ -e "$target" ] && ! is_owned_agent "$target"; then
    printf 'conflict: refusing to replace unowned agent %s\n' "$target" >&2
    conflicts=true
  fi
done

for source in "$source_skills"/*; do
  [ -d "$source" ] && [ -f "$source/SKILL.md" ] || continue
  name=$(basename -- "$source")
  target="$skills_dir/$name"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
      continue
    fi
    previous_target=$(manifest_skill_target "$name" 2>/dev/null || true)
    if [ -z "$previous_target" ]; then
      printf 'conflict: refusing to replace unowned skill %s\n' "$target" >&2
      conflicts=true
    elif [ ! -L "$target" ] || [ "$(readlink "$target")" != "$previous_target" ]; then
      printf 'conflict: previously owned skill was replaced outside interlink-claude: %s\n' "$target" >&2
      conflicts=true
    fi
  fi
done

if [ -L "$claude_md" ]; then
  printf 'conflict: refusing to modify symlinked instruction file %s\n' "$claude_md" >&2
  conflicts=true
elif [ -f "$claude_md" ]; then
  marker_state=$(awk -v start="$block_start" -v end="$block_end" '
    $0 == start {
      if (inside || seen) invalid = 1
      inside = 1
      seen = 1
      next
    }
    $0 == end {
      if (!inside) invalid = 1
      inside = 0
    }
    END { print (!invalid && !inside) ? "valid" : "invalid" }
  ' "$claude_md")
  if [ "$marker_state" != valid ]; then
    printf 'conflict: malformed interlink-claude block in %s\n' "$claude_md" >&2
    conflicts=true
  fi
fi

if [ "$conflicts" = true ]; then
  exit 1
fi

desired_claude_md="$tmp_dir/CLAUDE.md"
if [ -f "$claude_md" ]; then
  awk -v start="$block_start" -v end="$block_end" '
    $0 == start { owned = 1; next }
    owned && $0 == end { owned = 0; next }
    !owned { lines[++count] = $0 }
    END {
      while (count > 0 && lines[count] == "") count--
      for (i = 1; i <= count; i++) print lines[i]
    }
  ' "$claude_md" > "$desired_claude_md"
fi
if [ -s "$desired_claude_md" ]; then
  printf '\n' >> "$desired_claude_md"
fi
printf '%s\n@%s/opencode/AGENTS.md\n%s\n' "$block_start" "$script_dir" "$block_end" >> "$desired_claude_md"

report_change() {
  printf 'would update: %s\n' "$1"
  changed=true
}

for desired in "$tmp_dir/agents"/*.md; do
  [ -e "$desired" ] || continue
  target="$agents_dir/$(basename -- "$desired")"
  if [ ! -f "$target" ] || ! cmp -s "$desired" "$target"; then
    if [ "$check_only" = true ]; then
      report_change "$target"
    else
      mkdir -p -- "$agents_dir"
      cp -- "$desired" "$target"
      printf 'updated: %s\n' "$target"
    fi
  fi
done

for source in "$source_skills"/*; do
  [ -d "$source" ] && [ -f "$source/SKILL.md" ] || continue
  name=$(basename -- "$source")
  target="$skills_dir/$name"
  if [ ! -L "$target" ] || [ "$(readlink "$target")" != "$source" ]; then
    if [ "$check_only" = true ]; then
      report_change "$target"
    else
      mkdir -p -- "$skills_dir"
      rm -f -- "$target"
      ln -s -- "$source" "$target"
      printf 'linked: %s\n' "$target"
    fi
  fi
done

if [ ! -f "$claude_md" ] || ! cmp -s "$desired_claude_md" "$claude_md"; then
  if [ "$check_only" = true ]; then
    report_change "$claude_md"
  else
    mkdir -p -- "$claude_home"
    cp -- "$desired_claude_md" "$claude_md"
    printf 'updated managed block: %s\n' "$claude_md"
  fi
fi

if [ -f "$manifest" ]; then
  while IFS="$(printf '\t')" read -r type name previous_target; do
    [ -n "$type" ] && [ -n "$name" ] || continue
    if awk -F '\t' -v type="$type" -v name="$name" '$1 == type && $2 == name { found = 1 } END { exit found ? 0 : 1 }' "$desired_manifest"; then
      continue
    fi
    case "$type" in
      agent)
        case "$name" in *[!a-z0-9-]*) printf 'warning: ignoring unsafe agent manifest entry: %s\n' "$name" >&2; continue ;; esac
        target="$agents_dir/$name.md"
        if is_owned_agent "$target"; then
          if [ "$check_only" = true ]; then report_change "$target (remove)"; else rm -- "$target"; printf 'removed stale: %s\n' "$target"; fi
        fi
        ;;
      skill)
        case "$name" in *[!a-z0-9-]*) printf 'warning: ignoring unsafe skill manifest entry: %s\n' "$name" >&2; continue ;; esac
        target="$skills_dir/$name"
        if [ -n "$previous_target" ] && [ -L "$target" ] && [ "$(readlink "$target")" = "$previous_target" ]; then
          if [ "$check_only" = true ]; then report_change "$target (remove)"; else rm -- "$target"; printf 'removed stale: %s\n' "$target"; fi
        fi
        ;;
    esac
  done < "$manifest"
fi

if [ ! -f "$manifest" ] || ! cmp -s "$desired_manifest" "$manifest"; then
  if [ "$check_only" = true ]; then
    report_change "$manifest"
  else
    mkdir -p -- "$claude_home"
    cp -- "$desired_manifest" "$manifest"
  fi
fi

if [ "$check_only" = true ] && [ "$changed" = true ]; then
  exit 1
fi

if [ "$check_only" = true ]; then
  printf 'Claude configuration is in sync.\n'
else
  printf 'Claude configuration is interlinked.\n'
fi
